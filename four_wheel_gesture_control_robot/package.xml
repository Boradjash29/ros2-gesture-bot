<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>four_wheel_gesture_control</name>
  <version>1.0.0</version>
  <description>
    Four-wheel differential drive robot controlled via OpenCV hand gesture
    recognition using MediaPipe. Publishes geometry_msgs/Twist on /cmd_vel
    based on detected hand gestures from a webcam feed.

    Gesture Map:
      ✊  Fist            →  STOP
      🖐️  Open Palm       →  FORWARD
      ☝️  Point Up        →  FORWARD
      👇  Point Down      →  BACKWARD
      👈  Point Left      →  TURN LEFT
      👉  Point Right     →  TURN RIGHT
      ✌️  Peace Sign      →  BACKWARD SLOW
      🤙  Three Fingers   →  FORWARD FAST
  </description>

  <maintainer email="robot@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <!-- Build dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Runtime dependencies (ROS) -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- Python dependencies (pip install these) -->
  <!-- pip install mediapipe opencv-python numpy -->
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- Simulation dependencies -->
  <depend>gazebo_ros_pkgs</depend>
  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>

  <!-- Test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
